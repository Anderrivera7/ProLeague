# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Session pooler IPv4 (runtime). En redes sin IPv6 no uses db.*.supabase.co.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&connect_timeout=30&connection_limit=1&pool_timeout=30"

# Misma URL o connection directa para migraciones Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ─── Supabase Auth & API ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# ─── App ─────────────────────────────────────────────────────────────────────
# En producción usa https://tu-dominio.com (sin barra final)
# También añade en Supabase → Auth → URL Configuration:
#   Site URL y Redirect URLs: {APP_URL}/auth/callback
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ProLeague"

# ─── Sports APIs (public-apis Sports & Fitness) ───────────────────────────────
# TheSportsDB — clasificaciones y partidos reales (gratis con clave "3")
# https://www.thesportsdb.com/api.php
THE_SPORTS_DB_API_KEY="3"

# Scorebat — highlights de goles (token gratuito en scorebat.com/video-api/)
# SCOREBAT_API_TOKEN="your-scorebat-token"

# ─── Opcional ────────────────────────────────────────────────────────────────
# Solo para forzar seed en prod (peligroso). Por defecto bloqueado.
# ALLOW_PROD_SEED="true"
# NODE_ENV="development"
